# ── TODO ES OPCIONAL PARA PROBAR EN LOCAL ──
# La base de datos es un archivo local (prisma/dev.db) que se crea solo
# al ejecutar `npm run dev`. No necesitas configurar nada para empezar.

# NextAuth — obligatorio SOLO en producción. Genera uno con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Necesario solo si quieres el botón "Continuar con Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (https://dashboard.stripe.com/apikeys)
# Necesario solo cuando actives los pagos reales
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Correo del administrador (por defecto: danielortizvargas21@gmail.com)
ADMIN_EMAIL="danielortizvargas21@gmail.com"
