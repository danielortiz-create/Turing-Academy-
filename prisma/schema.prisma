generator client {
  provider = "prisma-client-js"
}

// SQLite: base de datos en un archivo local (prisma/dev.db), sin instalación.
// Para producción se puede cambiar a PostgreSQL ajustando provider y url.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Valores de role: STUDENT | ADMIN
// Valores de videoProvider: YOUTUBE | VIMEO | MP4 | SLIDES
// Valores de status (Purchase): PENDING | PAID | REFUNDED
// (SQLite no soporta enums de Prisma, por eso son String)

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String     @default("STUDENT")
  createdAt     DateTime   @default(now())
  accounts      Account[]
  sessions      Session[]
  purchases     Purchase[]
  progress      Progress[]
  tutorUsage    TutorUsage[]
  lessonUsage   TutorLessonUsage[]
  profile       LearnerProfile?
}

// Cuentas OAuth vinculadas (Google) — requerido por NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  subtitle    String?
  description String
  // Precio en centavos (USD) para evitar errores de redondeo con Stripe
  priceCents  Int        @default(0)
  imageUrl    String?
  published   Boolean    @default(false)
  // Muestra la etiqueta "Generado con IA" en el curso
  aiGenerated Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  modules     Module[]
  purchases   Purchase[]
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int      @default(0)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id            String     @id @default(cuid())
  moduleId      String
  title         String
  description   String?
  order         Int        @default(0)
  videoProvider String     @default("YOUTUBE")
  // YOUTUBE/VIMEO: id del video. MP4: nombre de archivo en storage/videos
  videoRef      String?
  durationMin   Int?
  // Lección de vista previa: visible sin comprar el curso
  isFreePreview Boolean    @default(false)
  module        Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      Progress[]
  slides        Slide[]
}

// Diapositiva de una lección tipo SLIDES. El texto es fijo; el tutor IA
// puede adaptarlo a pedido del alumno sin modificar este contenido.
model Slide {
  id         String  @id @default(cuid())
  lessonId   String
  order      Int     @default(0)
  title      String
  // Arreglo JSON de viñetas, p. ej. ["Punto 1", "Punto 2"]
  bullets    String
  highlight  String?
  // Contexto extra que solo ve el tutor IA (no se muestra en la slide)
  tutorNotes String?
  // Pregunta de comprobación (JSON): { question, options: [{ text, correct, why }] }
  quiz       String?
  lesson     Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  status          String   @default("PENDING")
  stripeSessionId String?  @unique
  amountCents     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Progress {
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

// Llamadas al tutor IA por usuario y día (tope global anti-abuso)
model TutorUsage {
  userId String
  day    String // YYYY-MM-DD (UTC)
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// Lecciones guiadas por día (límite de lecciones nuevas) y llamadas por lección
model TutorLessonUsage {
  userId   String
  day      String // YYYY-MM-DD (UTC)
  lessonId String
  count    Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, lessonId])
}

// Perfil del alumno para personalizar las explicaciones del tutor
model LearnerProfile {
  userId     String   @id
  role       String
  experience String
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
